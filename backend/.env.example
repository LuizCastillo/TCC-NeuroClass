# NeuroClass — backend/.env.example
# Copie para .env e preencha localmente. NUNCA commitar o .env (Parte X, cap. 64).
# Em produção (Railway), configure estas mesmas chaves no painel de variáveis
# de ambiente do serviço — nunca no código-fonte (Parte IV, cap. 28).

# Supabase — usado apenas pelo backend, nunca pelo frontend
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=SUA_CHAVE_DE_SERVICO_SUPABASE

# Resend — envio de e-mail de resultado
EMAIL_API_KEY=SUA_CHAVE_RESEND
EMAIL_FROM=NeuroClass <resultado@seudominio.com>

# CORS — origem exata do frontend em produção (domínio da Vercel)
CORS_ORIGIN=https://seu-projeto.vercel.app

# development | production
ENVIRONMENT=development
